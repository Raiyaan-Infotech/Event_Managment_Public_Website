# ── Backend ──────────────────────────────────────────────────────────────────
# The shared admin backend. Same server the admin panel and vendor portal use.
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# ── Tenant resolution ────────────────────────────────────────────────────────
# Local dev cannot point acme.com at localhost, so requests to localhost are
# treated as this host. NEVER set this in production: it pins every visitor to
# one tenant regardless of the domain they typed.
PUBLIC_SITE_DEV_HOST=eventify-co.eventinvit.test

# How long a rendered page is cached before the next request re-fetches the
# bundle. Raise it once builder saves trigger revalidation by tag.
PUBLIC_SITE_REVALIDATE=60

# ── Client portal ────────────────────────────────────────────────────────────
# Where a client is sent after a successful login. Separate app, own origin.
#
# This was missing from this file, and unset on the live deployment — so the
# production build inlined the local-dev default and every real login redirected
# to http://localhost:3005/dashboard. It only breaks on the visitor's machine,
# after a login that said "success", which is why it went unnoticed.
#
# REQUIRED. There is no fallback any more -- unset, a successful login reports
# "the client portal address is not configured" instead of navigating. That is
# deliberately louder than the old behaviour, which silently sent live visitors
# to localhost.
#
# NEXT_PUBLIC_* is inlined at BUILD time: changing it on the host does nothing
# until you redeploy.
#
#   local  http://localhost:3005/dashboard
#   live   https://eventmanagmentclient.vercel.app/dashboard
NEXT_PUBLIC_CLIENT_PORTAL_URL=http://localhost:3005/dashboard


# ── Backend-side (set these on the API server, not here) ─────────────────────
# Comma-separated roots that subdomains hang off. A host under one of these is
# looked up by company_websites.slug; anything else by custom_domain.
#   PUBLIC_SITE_ROOT_DOMAINS=eventinvit.app,event-invite.vercel.app
